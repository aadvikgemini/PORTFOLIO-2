# Example environment variables for Cloudflare Pages Functions (/functions/api/contact.js)
# Copy to .dev.vars for local `wrangler pages dev` testing, and configure real values
# inside your hosting provider's encrypted Environment Variables dashboard.
# NEVER commit real secrets or API keys to Git.

TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
RESEND_API_KEY=your_resend_api_key_here
CONTACT_TO_EMAIL=your-inbox@example.com
CONTACT_FROM_EMAIL=Portfolio <contact@example.com>
ALLOWED_ORIGIN=https://aadvikgemini.dev
